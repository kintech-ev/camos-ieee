---
import BaseLayout from '../components/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex={true}>
  <section class="section">
    <div class="container content-block" style="min-height:50vh;padding-top:3rem">
      <p class="eyebrow">404</p>
      <h1 style="font-size:clamp(2.6rem,7vw,5rem)">Page not found</h1>
      <p>The requested conference page does not exist or has not been published yet.</p>
      <a class="button button-primary" href="/">Return to ICAMC 2027</a>
    </div>
  </section>
</BaseLayout>
