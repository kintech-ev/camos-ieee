---
const target = 'https://www.kintech-ev.de/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* Without the viewport meta the fallback content renders at desktop width and
        is zoomed out on phones, so the manual link is unusable if the refresh is
        blocked or slow. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content="Redirecting to KINTECH" />
    <meta property="og:url" content={target} />
    <title>Redirecting to KINTECH</title>
    {/* This page does not use BaseLayout, so it carries its own minimal styles
        rather than importing the full site stylesheet for one line of text. */}
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: #ffffff;
        color: #172637;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        line-height: 1.62;
        text-align: center;
      }
      p { margin: 0; max-width: 46ch; }
      a {
        display: inline-block;
        /* Comfortable tap target (WCAG 2.5.8); #00629b is 6.52:1 on white. */
        padding: 0.5rem 0.25rem;
        color: #00629b;
        font-weight: 700;
      }
      a:hover { color: #0b2d4d; }
      a:focus-visible { outline: 3px solid #00629b; outline-offset: 2px; }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </head>
  <body>
    <p>
      Redirecting to <a href={target}>KINTECH<span class="visually-hidden"> (opens the external KINTECH website)</span></a>…
    </p>
  </body>
</html>
