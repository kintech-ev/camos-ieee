---
import { conference, navigation } from '../content';
interface Props { active?: string; }
const { active = '' } = Astro.props;
---
<header class="site-header">
  <div class="utility-bar">
    <div class="container utility-inner">
      <span>Organized and promoted by <a href="https://www.kintech-ev.de/"><strong>{conference.organizer}</strong></a></span>
      <div class="utility-meta" role="group" aria-label="Conference quick information">
        <span>{conference.dates}</span>
        <span>{conference.city}, {conference.country}</span>
        <span>{conference.format}</span>
      </div>
    </div>
  </div>

  <div class="masthead">
    <div class="container masthead-inner">
      <a href="/" class="brand" aria-label="CAMoS 2027 home">
        <span class="brand-mark">
          <img src="/assets/camos-logo.png" alt="" width="560" height="187" decoding="async" />
        </span>
      </a>
      <div class="masthead-event">
        <span class="masthead-kicker">Split, Croatia</span>
        <strong>{conference.dates}</strong>
        <span>{conference.format}</span>
      </div>
    </div>
  </div>

  <nav class="main-nav" aria-label="Primary navigation">
    <div class="container nav-inner">
      <button class="nav-toggle" aria-expanded="false" aria-controls="primary-menu">
        <span>Menu</span>
        <span class="nav-toggle-icon" aria-hidden="true">☰</span>
      </button>
      <ul id="primary-menu" class="nav-list">
        {navigation.map((item) => (
          <li>
            <a
              class:list={[active === item.href && 'is-active']}
              href={item.href}
              aria-current={active === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
        <li class="nav-submit-mobile"><a href={conference.submissionUrl}>Submit a Paper (EasyChair)</a></li>
      </ul>
      <a class="nav-cta" href={conference.submissionUrl}>Submit a Paper (EasyChair)</a>
    </div>
  </nav>
</header>

<script is:inline>
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.querySelector('#primary-menu');
  if (toggle instanceof HTMLButtonElement && menu) {
    const setMenu = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => {
      setMenu(toggle.getAttribute('aria-expanded') !== 'true');
    });
    // Same-page anchor links (e.g. /#themes) do not trigger a navigation, so the
    // disclosure would otherwise stay open on top of the section it just revealed.
    // Closing on activation keeps the destination visible and the state truthful.
    menu.addEventListener('click', (event) => {
      if (!event.target.closest('a')) return;
      setMenu(false);
    });
    // Disclosure pattern: Escape closes the menu and returns focus to the control.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      setMenu(false);
      toggle.focus();
    });
  }
</script>
