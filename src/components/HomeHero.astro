---
import { conference } from '../content';
import { withBase } from '../paths';
---
<section class="home-hero" aria-labelledby="home-hero-title">
  <img
    src={withBase('/assets/split-hero.webp')}
    alt="Coastal cityscape representing Split, Croatia"
    width="1672"
    height="941"
    fetchpriority="high"
    decoding="async"
  />
  <div class="home-hero-overlay"></div>
  <div class="container home-hero-content">
    <p class="eyebrow light">International Conference · 2027</p>
    <h1 id="home-hero-title">Connectivity, Automation<br />and Mobile Systems</h1>
    <p class="home-hero-lead">{conference.tagline}</p>
    <div class="hero-meta">
      <span>{conference.dates}</span>
      <span>{conference.city}, {conference.country}</span>
      <span>{conference.format}</span>
    </div>
    <div class="hero-actions">
      <a class="button button-primary" href={withBase('/call-for-papers')}>Call for Papers</a>
      <a class="button button-ghost-light" href="#themes">Explore the Themes</a>
    </div>
  </div>
</section>
