---
import { conference, navigation } from '../content';
import { withBase } from '../paths';
---
<footer class="site-footer">
  <div class="footer-accent" aria-hidden="true">
    <span class="c"></span><span class="a"></span><span class="m"></span>
  </div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <img
        src={withBase('/assets/camos-footer.webp')}
        alt="CAMoS 2027 — International Conference on Connectivity, Automation and Mobile Systems"
        width="1199"
        height="675"
        loading="lazy"
        decoding="async"
      />
      <span>{conference.dates} · {conference.city}, {conference.country}</span>
      <span>{conference.format}</span>
    </div>
    <div>
      <h2 class="footer-title">Conference</h2>
      <ul class="footer-links">
        {navigation.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Status</h2>
      <ul class="footer-links footer-static">
        <li><a href={conference.submissionUrl}>Paper submissions (EasyChair CFP)</a></li>
        <li>Rolling review planned</li>
        <li>IEEE Xplore pathway subject to approval</li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© 2027 CAMoS. Conference organization by <a href="https://www.kintech-ev.de/">KINTECH</a>.</span>
      <span>Connectivity · Automation · Mobile Systems</span>
    </div>
  </div>
</footer>
