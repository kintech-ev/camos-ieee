---
import '../styles.css';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  noindex?: boolean;
}

const {
  title = 'CAMoS 2027',
  description = 'International Conference on Connectivity, Automation and Mobile Systems — 2–6 August 2027, Split, Croatia.',
  active = '',
  noindex = false,
} = Astro.props;

const fullTitle = title === 'CAMoS 2027' ? title : `${title} | CAMoS 2027`;

// `Astro.site` comes from `site` in astro.config.mjs (PUBLIC_SITE_URL, else the
// production domain). Both are derived from it so no URL is hardcoded twice.
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL('/assets/split-hero.webp', Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta name="theme-color" content="#071b2f" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && (
      <meta
        property="og:image:alt"
        content="Coastal cityscape representing Split, Croatia, host city of CAMoS 2027"
      />
    )}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader active={active} />
    {/* tabindex="-1" makes the skip-link move focus reliably in every browser;
        it stays out of the normal tab order. */}
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>
