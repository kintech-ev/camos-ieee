---
import { withBase } from '../paths';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image?: string;
}
const { eyebrow, title, description, image = '/assets/network-split.webp' } = Astro.props;
---
<section class="page-hero">
  <img src={withBase(image)} alt="" aria-hidden="true" width="1672" height="941" fetchpriority="high" decoding="async" />
  <div class="page-hero-overlay"></div>
  <div class="container page-hero-content">
    <p class="eyebrow light">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>
